# probe-lean output written into the aux-fold fixture by its CI check. Anchored
# to the fixture rather than a bare `.verilib/`, so a hand-authored
# `.verilib/probes/config.json` in some future fixture stays addable.
tests/fixtures/aux-fold/.verilib/
tests/fixtures/aux-fold/lake-manifest.json
tests/fixtures/aux-fold/extract.stderr
tests/fixtures/aux-fold/check-axioms.out
tests/fixtures/collision/.verilib/
tests/fixtures/collision/lake-manifest.json
tests/fixtures/collision/extract.stderr
tests/fixtures/collision/check-axioms.out
tests/fixtures/merge/.verilib/
tests/fixtures/merge/lake-manifest.json
tests/fixtures/merge/extract.stderr
tests/fixtures/merge/extract.stdout
tests/fixtures/merge/check-axioms.out
tests/fixtures/merge/check-axioms.err
tests/fixtures/cross-merge/.verilib/
tests/fixtures/cross-merge/lake-manifest.json
tests/fixtures/cross-merge/dep/lake-manifest.json
tests/fixtures/cross-merge/extract.stderr
tests/fixtures/cross-merge/check-axioms.out
